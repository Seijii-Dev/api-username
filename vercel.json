{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/ig", "destination": "/api/index.ts" },
    { "source": "/info", "destination": "/api/index.ts" },
    { "source": "/pixel.gif", "destination": "/api/index.ts" },
    { "source": "/upload", "destination": "/api/index.ts" }
  ]
}