{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 30 }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/ig", "dest": "/api/index.ts" },
    { "src": "/info", "dest": "/api/index.ts" },
    { "src": "/pixel.gif", "dest": "/api/index.ts" },
    { "src": "/upload", "dest": "/api/index.ts" }
  ]
}
